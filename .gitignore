# Local audit/test artifacts -- screenshots, run logs, credential notes
# and per-test keystores produced by local audit runs. Generated
# artifacts, not source -- never committed.
_audit/
*_audit_tmp/

# Per-user keystore files (encrypted private key material) written at
# runtime -- any *.keystore file in any directory is a local runtime
# artifact, never source, never committed.
*.keystore
