# Environment configuration template.
#
# Copy to .env and fill in real values for this machine:
#     cp .env.example .env
#
# .env itself is gitignored and must NEVER be committed -- it holds
# real database credentials and the JWT signing secret. Every value
# below is a placeholder; none of them are real.
#
# Settings are grouped by which side of the deployment needs them
# (see config.py / config_server.py). After the client/server split is
# complete, a client machine will only need the CLIENT section.


# ---------------------------------------------------------------
# CLIENT + SERVER (shared, non-secret)
# ---------------------------------------------------------------

# Address the CLIENT dials to reach the chat server.
# Localhost for single-machine development; the server's LAN IP
# (e.g. 192.168.1.42) or public DNS name for a real deployment.
SERVER_HOST=127.0.0.1

# TCP port the chat server listens on. Both sides must agree.
SERVER_PORT=5000


# ---------------------------------------------------------------
# SERVER ONLY
# ---------------------------------------------------------------

# Network interface the SERVER binds to.
#   127.0.0.1 -> loopback only; unreachable from other devices (default)
#   0.0.0.0   -> all interfaces; required for LAN/internet access
# Left at loopback unless you explicitly intend to expose the server.
SERVER_BIND_HOST=127.0.0.1

# PostgreSQL connection string. Keep the database on the server host
# (localhost) -- clients must never connect to PostgreSQL directly.
# Percent-encode reserved characters in the password (e.g. @ -> %40).
DATABASE_URL=postgresql+psycopg2://REPLACE_USER:REPLACE_PASSWORD@localhost:5432/qrscs

# Secret used to sign JWTs. MUST be a long, random, unique value --
# anyone holding it can forge a token for any user. Generate with:
#     python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET

JWT_ISSUER=REPLACE_ISSUER
JWT_AUDIENCE=REPLACE_AUDIENCE

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Argon2id password-hashing parameters (OWASP minimums).
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# Consecutive failed logins before an account is locked.
MAX_FAILED_LOGIN_ATTEMPTS=5


# ---------------------------------------------------------------
# TLS (optional -- sensible defaults exist in config.py)
# ---------------------------------------------------------------

# Subject Alternative Names baked into the generated development
# server certificate (scripts/generate_dev_certs.py). The client
# verifies SERVER_HOST against these, so every address clients use to
# reach the server must appear here. Add the server's LAN IP for a
# multi-device test, e.g. "192.168.1.42,127.0.0.1,localhost".
# TLS_CERT_SANS=127.0.0.1,localhost

# Certificate/key/CA paths. Defaults point at certs/dev/ (generated by
# scripts/generate_dev_certs.py). Server needs cert+key; client needs
# only the CA certificate.
# TLS_CERT_FILE=certs/dev/server.crt
# TLS_KEY_FILE=certs/dev/server.key
# TLS_CA_FILE=certs/dev/ca.crt


# ---------------------------------------------------------------
# Storage (server only, optional)
# ---------------------------------------------------------------

# Where encrypted file/image blobs are stored on the server.
# FILE_STORAGE_ROOT=storage_blobs

# Maximum attachment size in bytes (default 25 MiB).
# MAX_ATTACHMENT_SIZE_BYTES=26214400
