# Virtual Environment
venv/

# Python Cache
__pycache__/
*.pyc

# Test / coverage artifacts -- regenerated by every `pytest` run.
.coverage
.pytest_cache/

# VS Code Settings
.vscode/

# Operating System Files
.DS_Store
Thumbs.db
# Runtime log files
logs/
*.log

# TLS certificates and private keys (development + any local
# deployment) -- generated locally by scripts/generate_dev_certs.py,
# never committed. See docs/architecture/tls_transport.md.
certs/

# Local environment configuration -- contains real database
# credentials and the JWT signing secret, and must never be
# committed. Copy .env.example to .env and fill in local values.
.env

# Encrypted payload blobs written at runtime by
# storage/encrypted_blob_store.py (FILE_STORAGE_ROOT). Generated
# artifacts, not source -- same rationale as logs/ and certs/ above.
storage_blobs/
# Per-user encrypted conversation-key stores written at runtime by
# storage/secure_key_store.py (KEY_STORE_DIR). Encrypted at rest, but
# they are a user's private key material and a local runtime artifact
# either way -- never source, and never committed.
.keystore/

# Database dumps. These are development snapshots of the live database
# and contain user records, Argon2 password hashes, session rows and
# message data -- never source, and never safe to commit. Two such
# dumps were previously committed and had to be removed from history
# (D8/F1), which is why this rule is explicit rather than assumed.
#
# Deliberately narrow: Alembic migrations live in alembic/versions/ as
# .py files and are NOT affected by these rules. If a legitimate .sql
# file is ever needed in the repository, add it with `git add -f` after
# confirming it contains no real data.
milestone2_backup.sql
milestone4_backup.sql
*_backup.sql

